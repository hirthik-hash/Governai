# backend/.env.example
# Copy this to .env and fill in real values. This file IS committed;
# .env itself is NOT.

APP_ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./governai_dev.db
REDIS_URL=redis://localhost:6379/0

# JWT_SECRET_KEY must be at least 32 characters. The value below is the
# public development default: fine locally, REFUSED when APP_ENV=production.
# Generate a private one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-before-any-real-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Development only - the password given to every demo user.
DEMO_USER_PASSWORD=Demo-Passw0rd-Change-Me

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

ESCALATION_TIMEOUT_SECONDS=1800
HARD_DENIAL_RISK_THRESHOLD=85
ESCALATION_RISK_THRESHOLD=40

# Logging
LOG_LEVEL=INFO
